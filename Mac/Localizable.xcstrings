            "value": "Supports SOCKS5 with proxy-side DNS resolution and HTTP CONNECT. Proxy passwords are not currently saved in host settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 SOCKS5（代理端解析域名）和 HTTP CONNECT。当前不在主机配置中保存代理密码。"
          }
        }
      }
    },
