          }
        }
      }
    },
    "合并后仅更新本机，不回传远端。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After merging, only this device is updated; the remote is not."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并后仅更新本机，不回传远端。"
          }
        }
      }
    },
    "合并后将更新本机与远端备份。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After merging, both this device and the remote backup are updated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并后将更新本机与远端备份。"
          }
        }
      }
    },
    "合并按 id 双向进行，冲突时逐项选择；删除不会同步（另一端下次会带回）。语言等设置同步后需重启生效。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge runs both ways by ID; resolve conflicts item by item. Deletions are not synced (the other side will bring them back). Language and other settings take effect after a restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并按 id 双向进行，冲突时逐项选择；删除不会同步（另一端下次会带回）。语言等设置同步后需重启生效。"
          }
        }
      }
    },
    "同名新文件夹": {
