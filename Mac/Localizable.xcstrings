          "stringUnit": {
            "state": "translated",
            "value": "该文件将被永久删除，不可恢复。"
          }
        }
      }
    },
    "该文件所在的目录在远端已不存在。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The directory containing this file no longer exists on the remote."
